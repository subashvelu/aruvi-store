# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local. Set the same variables in your hosting dashboard.

# Supabase (server-side only, service_role key bypasses RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_API_KEY=your-service-role-key

# Razorpay (use rzp_test_ keys while developing)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Admin area: a long random password + a separate long random signing secret
# Generate with: openssl rand -base64 32
ADMIN_ACCESS_KEY=change-me
ADMIN_SESSION_SECRET=change-me-too

# Email (digital product delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-app-password
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=Aruvi
